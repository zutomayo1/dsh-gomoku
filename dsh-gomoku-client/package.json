{
  "name": "dsh-gomoku-client",
  "version": "0.6.0",
  "description": "五子棋（Gomoku）· 浏览器半侧：右侧边栏里的棋盘（边聊边下），对手可切换本地引擎/模型",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "gomoku",
    "five-in-a-row"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "test/**/*.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/client-check.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
